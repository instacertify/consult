# Instacertify Consult — Environment

PORT=3000
BASE_URL=https://consult.instacertify.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
SESSION_SECRET=replace-with-long-random-string
# Set COOKIE_SECURE=false only if you must serve admin over plain HTTP
# COOKIE_SECURE=true

# Leads inbox (Google Workspace / Gmail)
LEAD_TO_EMAIL=contact@instacertify.com
LEAD_FROM_EMAIL=contact@instacertify.com

# Gmail SMTP (App Password) — see GMAIL_SETUP.md
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@instacertify.com
SMTP_PASS=

# Optional: disable email in local/dev (leads still saved in admin)
EMAIL_ENABLED=true
